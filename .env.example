# Optional. When set, the docs service may ask OpenAI to phrase an answer
# from passages it has already retrieved and from tool results it has already
# executed. Retrieval, routing, and operations all run without this key.
OPENAI_API_KEY=

# Optional overrides. Defaults match `npm run dev`.
# LUMEN_DATA_FILE=
# SEARCH_URL=http://localhost:4001
# ACTIONS_URL=http://localhost:4002
# VITE_SEARCH_URL=http://localhost:4001
# VITE_ACTIONS_URL=http://localhost:4002
# VITE_DOCS_URL=http://localhost:4003
# OPERATIONS_ENTRY=http://localhost:5174/remoteEntry.js
